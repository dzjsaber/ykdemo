# 复制本文件为 .env 后填入自己的 Key（.env 已在 .gitignore 中，不会被提交）

# 智谱 AI 开放平台 API Key：https://open.bigmodel.cn/ → 个人中心 → API Keys
ZHIPU_API_KEY=your-api-key-here

# ===== 可选：不改也能跑，下面是默认值 =====
# 对话模型（做模型选型时改这里，或命令行传 --model）
# glm-4-air 的 Function Calling 更稳；glm-4-flash 更便宜但需要代码里的兜底策略
# RAG_CHAT_MODEL=glm-4-flash

# 关键词兜底：命中这些词的问题，若模型没调用工具就强制检索一次（留空则关闭）
# RAG_FORCE_TOOL_KEYWORDS=英科

# Embedding 模型
# RAG_EMBEDDING_MODEL=embedding-3

# 切分参数（中文文档 chunk 太小语义不完整、太大检索不精准）
# RAG_CHUNK_SIZE=200
# RAG_CHUNK_OVERLAP=30

# 召回条数与余弦相似度阈值
# RAG_TOP_K=3
# RAG_MIN_SCORE=0.35

# 知识库文档路径（默认 data/yingke.txt）
# RAG_DOC_PATH=data/yingke.txt
